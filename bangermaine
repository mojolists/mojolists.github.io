<div class="max-w-7xl mx-auto px-6 py-20 relative z-10">
    <header class="mb-12">
        <h1 class="text-5xl font-black uppercase tracking-tighter text-white mb-2">Collection <span class="text-[#FFD700]">Archive</span></h1>
        <p class="text-white/40 uppercase tracking-[0.3em] text-[10px] font-bold">Sortable by performance, production, and mojo</p>
    </header>

    {# Sorting Headers #}
    <div class="grid grid-cols-12 gap-4 px-8 mb-4 items-center">
        <button onclick="sortTable(1)" class="col-span-3 text-left text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Artist</button>
        <button onclick="sortTable(2)" class="col-span-3 text-left text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Album</button>
        <button onclick="sortTable(3)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Year</button>
        <button onclick="sortTable(4)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Perf</button>
        <button onclick="sortTable(5)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Prod</button>
        <button onclick="sortTable(6)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Dance</button>
        <button onclick="sortTable(7)" class="col-span-2 text-right text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#FFD700] transition-colors">Mojo %</button>
    </div>

    {# The Archive List #}
    <div id="archiveList" class="space-y-2">
        {% for review in collections.reviews | reverse %}
        {% set s1 = review.data.score1 | default(0) %}
        {% set s2 = review.data.score2 | default(0) %}
        {% set s3 = review.data.score3 | default(0) %}
        {% set avg = ((s1 + s2 + s3) / 3) | round %}

        <a href="{{ review.url }}" class="archive-row glass-card grid grid-cols-12 gap-4 px-8 py-4 items-center group hover:border-[#FFD700]/30 transition-all duration-300">
            {# Artist #}
            <div class="col-span-3 font-bold text-white group-hover:text-[#FFD700] transition-colors">
                {{ review.data.artist }}
            </div>
            
            {# Album #}
            <div class="col-span-3 text-white/60 text-sm">
                {{ review.data.album }}
            </div>

            {# Year #}
            <div class="col-span-1 text-center text-white/40 font-mono text-xs">
                {{ review.data.year }}
            </div>

            {# Score 1 #}
            <div class="col-span-1 text-center text-[#FFD700]/60 font-bold group-hover:text-[#FFD700]">
                {{ s1 }}
            </div>

            {# Score 2 #}
            <div class="col-span-1 text-center text-[#FFD700]/60 font-bold group-hover:text-[#FFD700]">
                {{ s2 }}
            </div>

            {# Score 3 #}
            <div class="col-span-1 text-center text-[#FFD700]/60 font-bold group-hover:text-[#FFD700]">
                {{ s3 }}
            </div>

            {# Average Mojo #}
            <div class="col-span-2 text-right italic font-black text-[#FFD700] text-xl">
                {{ avg }}%
            </div>
        </a>
        {% endfor %}
    </div>
</div>

<script>
function sortTable(columnIndex) {
    const list = document.getElementById('archiveList');
    const rows = Array.from(list.getElementsByClassName('archive-row'));
    
    const sortedRows = rows.sort((a, b) => {
        const aVal = a.children[columnIndex - 1].innerText.trim();
        const bVal = b.children[columnIndex - 1].innerText.trim();
        
        // Check if numeric
        if (!isNaN(aVal) && !isNaN(bVal)) {
            return parseFloat(bVal) - parseFloat(aVal); // Sort numbers descending
        }
        return aVal.localeCompare(bVal); // Sort text ascending
    });

    list.innerHTML = '';
    sortedRows.forEach(row => list.appendChild(row));
}
</script>

