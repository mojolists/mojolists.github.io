---
layout: base.njk
---
{# Fetch navigation items #}
{%- set nextPost = collections.reviews | getNextCollectionItem(page) %}
{%- set previousPost = collections.reviews | getPreviousCollectionItem(page) %}

<div class="fixed inset-0 -z-20 overflow-hidden pointer-events-none">
    <img src="/assets/img/{{ image }}" class="w-full h-full object-cover opacity-20 blur-3xl scale-110" alt="">
    <div class="absolute inset-0 bg-black/40"></div>
</div>

<article class="max-w-6xl mx-auto px-6 py-12 relative">
    
    {# Desktop Navigation Arrows #}
    {% if previousPost %}
    <a href="{{ previousPost.url }}" class="fixed left-8 top-1/2 -translate-y-1/2 hidden xl:flex flex-col items-start group z-50">
        <span class="text-[#DAA520] text-4xl font-light mb-2 transition-transform group-hover:-translate-x-2">←</span>
        <span class="text-[#DAA520] text-[10px] font-bold uppercase tracking-[0.3em] vertical-text opacity-60 group-hover:opacity-100 transition-opacity">
            {{ previousPost.data.artist }}
        </span>
    </a>
    {% endif %}

    {% if nextPost %}
    <a href="{{ nextPost.url }}" class="fixed right-8 top-1/2 -translate-y-1/2 hidden xl:flex flex-col items-end group z-50">
        <span class="text-[#DAA520] text-4xl font-light mb-2 transition-transform group-hover:translate-x-2">→</span>
        <span class="text-[#DAA520] text-[10px] font-bold uppercase tracking-[0.3em] vertical-text opacity-60 group-hover:opacity-100 transition-opacity">
            {{ nextPost.data.artist }}
        </span>
    </a>
    {% endif %}

    <header class="flex flex-col lg:flex-row gap-8 justify-center items-end mb-20">
        
        <div class="fixed-square">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card fixed-square relative overflow-hidden">
            <div class="flex flex-col h-full">
                
                <div class="mb-auto">
                    <h1 class="artist-heading text-white mb-1">
                        {{ artist }}
                    </h1>
                    
                    <h2 class="album-subheading mb-10">
                        {{ album }}
                    </h2>

                    <div class="space-y-4">
                        <div class="metadata-row">
                            <span class="metadata-label">Label</span>
                            <span class="metadata-value">{{ label }}</span>
                        </div>
                        <div class="metadata-row">
                            <span class="metadata-label">Released</span>
                            <span class="metadata-value">{{ year }}</span>
                        </div>
                    </div>
                </div>

                <div class="pt-8 border-t border-white/10">
                    <span class="metadata-label block mb-2">Mojo Rating</span>
                    <div class="mojo-rating">
                        {{ score }}%
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto review-content space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="max-w-5xl mx-auto my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}

    {# Mobile Navigation Footer #}
    <div class="xl:hidden flex justify-between items-center mt-20 pt-10 border-t border-white/10">
        {% if previousPost %}
        <a href="{{ previousPost.url }}" class="flex flex-col">
            <span class="text-[#DAA520] text-[10px] font-bold uppercase tracking-widest mb-1">← Previous</span>
            <span class="text-white/40 text-[9px] uppercase tracking-wider">{{ previousPost.data.artist }}</span>
        </a>
        {% else %}
        <div></div>
        {% endif %}

        {% if nextPost %}
        <a href="{{ nextPost.url }}" class="flex flex-col items-end text-right">
            <span class="text-[#DAA520] text-[10px] font-bold uppercase tracking-widest mb-1">Next →</span>
            <span class="text-white/40 text-[9px] uppercase tracking-wider">{{ nextPost.data.artist }}</span>
        </a>
        {% endif %}
    </div>
</article>

<style>
    /* Styling for the vertical artist names in navigation */
    .vertical-text {
        writing-mode: vertical-rl;
        text-orientation: mixed;
    }
</style>