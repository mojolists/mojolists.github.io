<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | MojoLists</title>
    <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mojoGold: '#c5a059',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0a0a0a;
            color: #e5e5e5;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .prose blockquote {
            border-left-color: #dc2626 !important;
            color: #e5e5e5 !important;
            font-style: italic;
        }
    </style>
</head>
<body class="min-h-screen py-12 px-4 selection:bg-mojoGold selection:text-black">

    <main class="max-w-4xl mx-auto">
        
        {# Mojo Rating Logic #}
        {% set mojoScore = ((listenability + danceability + musicality) / 3) | round %}
        {% if not listenability and not danceability and not musicality %}
            {% set mojoScore = score %}
        {% endif %}

        <article class="glass-card rounded-2xl overflow-hidden shadow-2xl">
            
            <div class="relative h-80 w-full">
                <img src="/img/{{ image }}" alt="{{ album }}" class="w-full h-full object-cover">
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8">
                    <h1 class="text-5xl font-black text-white tracking-tight uppercase italic">{{ album }}</h1>
                    <p class="text-mojoGold text-lg font-bold tracking-widest uppercase mt-2">{{ artist }}</p>
                </div>
            </div>

            <div class="p-8 md:p-12">
                
                <div class="flex flex-col items-center mb-16">
                    <div class="bg-transparent text-center">
                        <div class="text-[10rem] font-black text-white leading-none tracking-tighter">{{ mojoScore }}</div>
                        <div class="text-xs uppercase tracking-[0.6em] text-mojoGold mt-2 font-bold">Mojo Rating</div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full max-w-2xl mt-12 pt-8 border-t border-white/10">
                        <div class="text-center">
                            <div class="text-3xl font-black text-white">{{ listenability if listenability else "—" }}</div>
                            <div class="text-[10px] uppercase tracking-widest text-mojoGold font-bold mt-1">Listenability</div>
                        </div>
                        <div class="text-center border-x border-white/10 px-4">
                            <div class="text-3xl font-black text-white">{{ danceability if danceability else "—" }}</div>
                            <div class="text-[10px] uppercase tracking-widest text-mojoGold font-bold mt-1">Danceability</div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-black text-white">{{ musicality if musicality else "—" }}</div>
                            <div class="text-[10px] uppercase tracking-widest text-mojoGold font-bold mt-1">Musicality</div>
                        </div>
                    </div>
                </div>

                <div class="prose prose-invert max-w-none prose-p:leading-relaxed prose-p:text-gray-300">
                    <div class="flex items-center gap-4 text-xs text-gray-500 uppercase tracking-[0.3em] mb-10 border-b border-white/5 pb-6">
                        <span>{{ label }}</span>
                        <span class="text-white/20">•</span>
                        <span>{{ year }}</span>
                        <span class="text-white/20">•</span>
                        <span>{{ date | dateFilter }}</span>
                    </div>

                    {{ content | safe }}
                </div>

            </div>
        </article>

        <div class="mt-16 text-center">
            <a href="/archive" class="inline-block px-8 py-3 border border-white/10 text-gray-500 hover:text-mojoGold hover:border-mojoGold transition-all uppercase tracking-widest text-xs font-bold rounded-sm">
                ← Back to Archive
            </a>
        </div>

    </main>

</body>
</html>