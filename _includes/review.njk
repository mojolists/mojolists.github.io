---
layout: base.njk
---
<article class="max-w-5xl mx-auto px-6 py-16">
    <header class="flex flex-col lg:flex-row gap-8 items-end mb-12">
        <img src="/assets/img/{{ image }}" class="w-[400px] h-[400px] object-cover border border-white/10 rounded-sm">
        
        <div class="glass-card p-10 h-[400px] flex flex-col justify-between w-full lg:w-[450px]">
            <div>
                <h1 class="text-white mb-2 leading-tight break-words" style="font-size: clamp(1.5rem, 5vw, 3rem); font-weight: 900;">
                    {{ artist }}
                </h1>
                
                <p class="text-lg text-red-500 font-extrabold uppercase italic">{{ album }}</p>
                <div class="mt-4">
                    <p class="text-[10px] uppercase text-slate-500 font-bold">Label: <span class="text-white font-normal">{{ label }}</span></p>
                    <p class="text-[10px] uppercase text-slate-500 font-bold">Released: <span class="text-white font-normal">{{ year }}</span></p>
                </div>
            </div>
            
            <div class="text-center border-t border-white/10 pt-4">
                <span class="text-3xl font-black text-white italic">
                    {{ score }}{% if score <= 10 %}0{% endif %}% 
                    <span class="text-base text-slate-600 font-normal ml-2">Mojo Rating</span>
                </span>
            </div>
        </div>
    </header>

    <div class="prose prose-invert prose-lg max-w-none text-slate-200 leading-relaxed mb-12">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="my-16 aspect-video border border-white/10 rounded-sm overflow-hidden">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>