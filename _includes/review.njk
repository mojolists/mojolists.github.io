---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-6 py-12">
    <header class="flex flex-col lg:flex-row gap-8 justify-center items-end mb-16">
        
        <div class="fixed-square">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card fixed-square relative overflow-hidden">
            <div class="flex flex-col h-full">
                <div class="flex justify-between items-start mb-4">
                    <div class="text-xl uppercase logo-mojo text-[10px] tracking-widest">
                        MOJO<span class="logo-lists">LISTS</span>
                    </div>
                </div>
                
                <div class="mb-auto">
                    <h1 class="artist-heading text-white mb-1">
                        {{ artist }}
                    </h1>
                    <h2 class="album-subheading text-[#e63946] uppercase font-bold tracking-tight mb-6">
                        {{ album }}
                    </h2>

                    <div class="space-y-1">
                        <div class="metadata-text">
                            <span class="opacity-40">Label:</span> {{ label }}
                        </div>
                        <div class="metadata-text">
                            <span class="opacity-40">Released:</span> {{ year }}
                        </div>
                    </div>
                </div>

                <div class="pt-6 flex items-end justify-between border-t border-white/10">
                    <div class="flex flex-col">
                        <span class="metadata-text mb-1" style="letter-spacing: 0.1em;">Mojo Rating</span>
                        <div class="mojo-rating">
                            {{ score }}%
                        </div>
                    </div>
                    
                    <div class="pb-2">
                        <a href="/reviews/" class="btn-gold">
                            ARCHIVE
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto review-content space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="max-w-5xl mx-auto my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>