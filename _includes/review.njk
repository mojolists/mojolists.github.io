<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review: {{ artist }} - {{ title }} | MojoLists</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #94a3b8; margin: 0; padding: 0; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        :root { --mojo-gold: #c5a059; --mojo-red: #ef4444; }
        .hero-bg-zoom { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-image: url('/{{ coverImage }}'); background-size: cover; background-position: center; filter: brightness(0.25) saturate(1.2); z-index: -1; }
        .overlay-gradient { position: fixed; inset: 0; background: linear-gradient(to bottom, rgba(11, 17, 32, 0.4) 0%, rgba(11, 17, 32, 0.95) 100%); z-index: -1; }
        .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; max-width: 420px; padding: 1.25rem; background-color: transparent; color: var(--mojo-gold); font-weight: 900; text-transform: uppercase; letter-spacing: 0.25em; font-size: 0.75rem; transition: all 0.3s ease; text-decoration: none; border: 1px solid var(--mojo-gold); }
    </style>
</head>
<body>
    <div class="hero-bg-zoom"></div>
    <div class="overlay-gradient"></div>
    <main class="relative z-10">
        <header class="pt-24 pb-12 max-w-5xl mx-auto px-6">
            <div class="flex flex-col lg:flex-row gap-8 items-end lg:ml-12">
                <div class="flex-shrink-0"><img src="/{{ coverImage }}" class="w-[400px] h-[400px] object-cover border border-white/10 rounded-sm"></div>
                <div class="w-full lg:w-[450px]">
                    <div class="glass-card p-10 h-[400px] flex flex-col justify-between">
                        <div>
                            <h1 class="serif text-5xl text-white mb-2 leading-tight">{{ artist }}</h1>
                            <p class="text-lg text-red-500 font-extrabold uppercase tracking-widest italic mb-8">{{ title }}</p>
                        </div>
                        <div class="mojo-rating-box text-center">
                            <span class="text-3xl font-black text-white italic serif">
                                {{ (mojo.soundQuality + mojo.music + mojo.boogieLevel) / 3 | round(1) }} <span class="text-base text-slate-600 font-normal">/ 10</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <div class="max-w-5xl mx-auto px-6 py-16">
            <article class="lg:ml-12 lg:pr-24 text-white text-lg leading-relaxed">{{ content | safe }}</article>
        </div>
    </main>
</body>
</html>