---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-6 py-12">
    <header class="flex flex-col lg:flex-row gap-8 justify-center items-center mb-16">
        <div class="w-[400px] h-[400px] flex-shrink-0">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card p-10 flex flex-col justify-between w-[400px] h-[400px] flex-shrink-0">
            <div class="overflow-hidden">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-[#c5a059] uppercase tracking-[0.4em] text-[10px] font-black">
                        {{ label }} // {{ year }}
                    </span>
                    <span class="logo-font text-white text-lg font-bold italic tracking-tighter">
                        MOJO<span class="text-red-600 font-normal">LISTS</span>
                    </span>
                </div>
                
                <h1 class="text-white font-black uppercase tracking-tighter leading-[0.85] mb-2 break-words" 
                    style="font-size: clamp(1.5rem, 4.5vw, 3.5rem);">
                    {{ artist }}
                </h1>
                
                <h2 class="text-[#c5a059] text-lg font-extrabold uppercase italic tracking-widest leading-tight">
                    {{ album }}
                </h2>
            </div>

            <div class="pt-6 flex items-end justify-between border-t border-white/5 bg-transparent">
                <div class="flex flex-col">
                    <span class="text-slate-500 uppercase text-[8px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline">
                        <span class="text-5xl font-black text-white italic tracking-tighter leading-none">{{ score }}%</span>
                        <span class="text-[10px] text-slate-600 font-bold uppercase ml-2 tracking-widest">Rating</span>
                    </div>
                </div>
                
                <div class="pb-1">
                    <div class="px-5 py-2 border border-[#c5a059] text-[#c5a059] text-[9px] uppercase tracking-[0.3em] font-black hover:bg-[#c5a059] hover:text-black transition-all">
                        REVIEW
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto text-slate-300 text-lg leading-relaxed space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>