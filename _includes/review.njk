---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-4 py-12">
    <div class="relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-sm overflow-hidden shadow-2xl flex flex-col md:flex-row mb-16">
        
        <div class="w-full md:w-5/12 aspect-square">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover">
        </div>

        <div class="w-full md:w-7/12 p-8 md:p-12 flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-[#c5a059] uppercase tracking-[0.3em] text-[10px] font-bold">{{ label }}</span>
                    <span class="text-white/20">•</span>
                    <span class="text-white/60 text-[10px] font-mono">{{ year }}</span>
                </div>

                <h1 class="text-white font-black leading-[0.9] mb-4 break-words uppercase tracking-tighter" 
                    style="font-size: clamp(1.75rem, 5vw, 4.5rem);">
                    {{ artist }}
                </h1>
                
                <h2 class="text-gray-400 text-xl md:text-2xl font-light italic mb-8 border-l border-white/10 pl-4">
                    {{ album }}
                </h2>
            </div>

            <div class="mt-auto pt-8 flex items-end justify-between">
                <div class="flex flex-col">
                    <span class="text-[#c5a059] uppercase text-[9px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline bg-transparent">
                        <span class="text-6xl md:text-7xl font-black text-white leading-none">{{ score }}</span>
                        <span class="text-2xl font-bold text-[#c5a059] ml-1">%</span>
                    </div>
                </div>
                
                <div class="hidden md:block">
                     <div class="w-12 h-1 border-t border-white/20 mb-2"></div>
                     <span class="text-white/30 text-[10px] uppercase tracking-widest">Album Review</span>
                </div>
            </div>
        </div>
    </div>

    <div class="max-w-3xl mx-auto">
        <div class="prose prose-invert prose-red 
            prose-p:text-gray-300 prose-p:leading-relaxed prose-p:text-lg
            prose-strong:text-white prose-strong:font-bold
            prose-a:text-[#c5a059] prose-a:no-underline hover:prose-a:text-white transition-colors">
            {{ content | safe }}
        </div>
    </div>
</article>