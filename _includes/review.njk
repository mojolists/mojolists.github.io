---
layout: base.njk
---

<article class="review-page">
    <div class="red-line"></div>
    
    <header class="flex flex-col lg:flex-row gap-8 justify-center items-center mb-16">
        <div class="w-[400px] h-[400px] flex-shrink-0">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card p-10 flex flex-col justify-between w-[400px] h-[400px] flex-shrink-0 relative overflow-hidden bg-white/5 border border-white/10">
            <div>
                <div class="flex justify-between items-start mb-6">
                    <span class="text-[#666] uppercase tracking-[0.4em] text-[10px] font-black">
                        {{ label }} // {{ year }}
                    </span>
                    <a href="/reviews/" class="text-white text-lg font-black italic tracking-tighter uppercase">
                        MOJO<span style="color: #e63946;">LISTS</span>
                    </a>
                </div>
                
                <h1 class="text-white font-black uppercase tracking-tighter leading-[0.85] mb-2 break-words" 
                    style="font-family: 'Montserrat', sans-serif; font-weight: 900; font-size: clamp(1.8rem, 5vw, 3.5rem);">
                    {{ artist }}
                </h1>
                
                <h2 class="italic uppercase tracking-widest leading-tight" style="color: #e63946; font-size: 1.2rem; font-weight: 800;">
                    {{ album }}
                </h2>

                <div class="mt-4 space-y-1">
                    <p class="text-[10px] uppercase tracking-widest text-[#666] font-bold">Label: <span class="text-white font-normal ml-2">{{ label }}</span></p>
                    <p class="text-[10px] uppercase tracking-widest text-[#666] font-bold">Released: <span class="text-white font-normal ml-2">{{ year }}</span></p>
                </div>
            </div>

            <div class="pt-6 flex items-end justify-between bg-transparent border-t border-white/10">
                <div class="flex flex-col">
                    <span class="text-[#666] uppercase text-[8px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline bg-transparent">
                        <span class="text-5xl font-black text-white italic tracking-tighter leading-none" style="font-family: 'Montserrat', sans-serif;">{{ score }}%</span>
                        <span class="text-[10px] text-[#666] font-bold uppercase ml-2 tracking-widest">Rating</span>
                    </div>
                </div>
                
                <div class="pb-1">
                    <div class="px-5 py-2 border border-[#DAA520] text-[#DAA520] text-[9px] uppercase tracking-[0.3em] font-black hover:bg-[#DAA520] hover:text-black transition-all">
                        REVIEW
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="review-text max-w-3xl mx-auto text-[#ffffff] text-lg leading-relaxed space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="video-container mt-16">
        <div class="red-line"></div>
        <h3 class="section-heading">Listen</h3>
        <div class="aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
            <iframe width="100%" height="450" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
        </div>
    </div>
    {% endif %}
</article>