---
layout: base.njk
---
<article class="max-w-5xl mx-auto px-6 py-16">
    <header class="flex flex-col lg:flex-row gap-8 items-stretch mb-12">
        <div class="w-full lg:w-1/2">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full aspect-square object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card p-10 flex flex-col justify-between w-full lg:w-1/2">
            <div>
                <span class="text-[#c5a059] uppercase tracking-[0.4em] text-[10px] font-black mb-4 block">{{ label }} // {{ year }}</span>
                
                <h1 class="text-white font-black uppercase tracking-tighter leading-[0.85] mb-4 break-words" 
                    style="font-size: clamp(2rem, 6vw, 4.5rem);">
                    {{ artist }}
                </h1>
                
                <h2 class="text-gray-400 text-xl font-light italic uppercase tracking-wide">
                    {{ album }}
                </h2>
            </div>

            <div class="pt-8 flex items-end justify-between bg-transparent">
                <div class="flex flex-col">
                    <span class="text-[#c5a059] uppercase text-[9px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline">
                        <span class="text-7xl font-black text-white leading-none tracking-tighter">{{ score }}</span>
                        <span class="text-2xl font-bold text-[#c5a059] ml-1">%</span>
                    </div>
                </div>
                
                <div class="pb-2">
                    <div class="px-6 py-2 border border-[#c5a059] text-[#c5a059] text-[10px] uppercase tracking-widest font-black hover:bg-[#c5a059] hover:text-black transition-all cursor-pointer">
                        Album Review
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto">
        <div class="prose prose-invert prose-red 
            prose-p:text-gray-300 prose-p:leading-relaxed prose-p:text-lg
            prose-strong:text-white prose-strong:font-bold
            prose-a:text-[#c5a059] prose-a:no-underline hover:prose-a:text-white transition-colors">
            {{ content | safe }}
        </div>
    </div>
</article>