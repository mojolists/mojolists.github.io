---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-6 py-12">
    <header class="flex flex-col lg:flex-row gap-8 justify-center items-center mb-16">
        
        <div class="w-[400px] h-[400px] flex-shrink-0">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card p-10 flex flex-col justify-between w-[400px] h-[400px] flex-shrink-0 relative overflow-hidden">
            <div>
                <div class="flex justify-between items-start mb-6">
                    <span class="text-[#c5a059] uppercase tracking-[0.4em] text-[10px] font-black">
                        {{ label }} // {{ year }}
                    </span>
                    <a href="/reviews/" class="text-xl text-white font-light italic tracking-tighter uppercase logo-font">
                        MOJO<span class="text-red-500 font-normal">LISTS</span>
                    </a>
                </div>
                
                <h1 class="text-white font-black uppercase tracking-tighter leading-[0.85] mb-4 break-words" 
                    style="font-size: clamp(1.8rem, 5vw, 4rem);">
                    {{ artist }}
                </h1>
                
                <h2 class="text-[#c5a059] text-xl font-extrabold uppercase italic tracking-widest leading-tight">
                    {{ album }}
                </h2>
            </div>

            <div class="pt-8 flex items-end justify-between bg-transparent border-t border-white/10">
                <div class="flex flex-col">
                    <span class="text-slate-500 uppercase text-[9px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline bg-transparent">
                        <span class="text-6xl font-black text-white italic tracking-tighter leading-none">{{ score }}%</span>
                        <span class="text-xs text-slate-600 font-bold uppercase ml-2 tracking-widest">Rating</span>
                    </div>
                </div>
                
                <div class="pb-2">
                    <a href="/reviews/" class="px-6 py-2 border border-[#c5a059] text-[#c5a059] text-[10px] uppercase tracking-[0.3em] font-black hover:bg-[#c5a059] hover:text-black transition-all">
                        ARCHIVE
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto text-slate-200 text-lg leading-relaxed space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>