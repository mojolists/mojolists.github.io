---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-6 py-12">
    <header class="flex flex-col lg:flex-row gap-8 items-stretch mb-16">
        <div class="w-full lg:w-1/2">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full aspect-square object-cover border border-white/10 rounded-sm">
        </div>
        
        <div class="glass-card p-10 flex flex-col justify-between w-full lg:w-1/2 min-h-[450px]">
            <div>
                <span class="text-[#c5a059] uppercase tracking-[0.4em] text-[10px] font-black mb-6 block">
                    {{ label }} // {{ year }}
                </span>
                
                <h1 class="text-white text-5xl md:text-6xl font-black uppercase tracking-tighter leading-[0.85] mb-4 break-words">
                    {{ artist }}
                </h1>
                
                <h2 class="text-[#c5a059] text-xl font-extrabold uppercase italic tracking-widest">
                    {{ album }}
                </h2>
            </div>

            <div class="pt-8 flex items-end justify-between border-t border-white/10 bg-transparent">
                <div class="flex flex-col">
                    <span class="text-slate-500 uppercase text-[9px] tracking-[0.4em] mb-1 font-bold">Mojo Confidence</span>
                    <div class="flex items-baseline">
                        <span class="text-6xl font-black text-white italic tracking-tighter">{{ score }}%</span>
                        <span class="text-sm text-slate-600 font-bold uppercase ml-2 tracking-widest">Rating</span>
                    </div>
                </div>
                
                <div class="pb-2">
                    <div class="px-8 py-3 border border-[#c5a059] text-[#c5a059] text-[10px] uppercase tracking-[0.3em] font-black hover:bg-[#c5a059] hover:text-black transition-all">
                        Album Review
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto text-slate-200 text-lg leading-relaxed space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>