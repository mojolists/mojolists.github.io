---
layout: base.njk
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review: {{ artist }} - {{ album }} | MojoLists</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #94a3b8; margin: 0; padding: 0; }
        .serif { font-family: 'Playfair Display', serif; }
        :root { --mojo-gold: #c5a059; --mojo-red: #ef4444; }
        .hero-bg-zoom { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-image: url('/assets/img/{{ image }}'); background-size: cover; background-position: center; filter: brightness(0.15) saturate(1.2); z-index: -1; }
        .overlay-gradient { position: fixed; inset: 0; background: linear-gradient(to bottom, rgba(11, 17, 32, 0.4) 0%, rgba(11, 17, 32, 0.95) 100%); z-index: -1; }
        .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
        
        /* This ensures all paragraphs in your Markdown render correctly */
        .article-content p { margin-bottom: 2rem; font-size: 1.125rem; line-height: 1.8; color: #e2e8f0; }
        .article-content em { color: #fff; font-style: italic; }
        
        .mojo-rating-box { width: 100%; padding: 1rem 0; text-align: center; border-top: 1px solid rgba(255,255,255,0.1); }
        .info-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: #64748b; margin-bottom: 2px; }
        .info-value { font-size: 14px; color: white; font-weight: 400; margin-bottom: 16px; }

        .btn-container { margin: 3rem 0; display: flex; flex-direction: row; justify-content: center; gap: 1.5rem; }
        .action-btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; max-width: 320px; padding: 1.25rem; border: 1px solid var(--mojo-gold); color: var(--mojo-gold); font-weight: 900; text-transform: uppercase; letter-spacing: 0.25em; font-size: 0.75rem; transition: all 0.3s ease; text-decoration: none; }
        .action-btn:hover { background-color: var(--mojo-gold); color: #0b1120; }
    </style>
</head>
<body>
    <div class="hero-bg-zoom"></div>
    <div class="overlay-gradient"></div>

    <main class="relative z-10">
        <header class="pt-24 pb-12 max-w-5xl mx-auto px-6 text-left">
            <div class="flex flex-col lg:flex-row gap-8 items-end">
                <div class="flex-shrink-0">
                    <img src="/assets/img/{{ image }}" class="w-[400px] h-[400px] object-cover border border-white/10 rounded-sm shadow-2xl">
                </div>
                <div class="w-full lg:w-[450px]">
                    <div class="glass-card p-10 h-[400px] flex flex-col justify-between">
                        <div>
                            <h1 class="serif text-5xl text-white mb-2 leading-tight">{{ artist }}</h1>
                            <p class="text-lg text-red-500 font-extrabold uppercase tracking-widest italic mb-8">{{ album }}</p>
                            <div class="mt-4">
                                <p class="info-label">Label</p>
                                <p class="info-value">{{ label }}</p>
                                <p class="info-label">Released</p>
                                <p class="info-value">{{ year }}</p>
                            </div>
                        </div>
                        <div class="mojo-rating-box">
                            <span class="text-3xl font-black text-white italic serif">
                                {{ score }}{% if score <= 10 %}0{% endif %}% <span class="text-base text-slate-600 font-normal">Mojo Rating</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="max-w-5xl mx-auto px-6 py-16">
            <article class="article-content lg:pr-24">
                {% if featuredQuote %}
                <div class="serif text-2xl text-white italic border-l-4 border-red-500 pl-8 py-4 mb-12 leading-relaxed">
                    "{{ featuredQuote }}"
                </div>
                {% endif %}

                {{ content | safe }}

                {% if youtubeId %}
                <div class="my-16 aspect-video rounded-sm overflow-hidden border border-white/10 shadow-2xl">
                    <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
                </div>
                {% endif %}

                <div class="btn-container">
                    {% if buyLink %}
                    <a href="{{ buyLink }}" target="_blank" class="action-btn">Buy Album</a>
                    {% endif %}
                    {% if listenLink %}
                    <a href="{{ listenLink }}" target="_blank" class="action-btn">Listen on Spotify</a>
                    {% endif %}
                </div>
            </article>
        </div>
    </main>
</body>
</html>