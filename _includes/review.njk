---
layout: base.njk
---
<article class="max-w-6xl mx-auto px-6 py-12">
    <header class="flex flex-col lg:flex-row gap-8 justify-center items-end mb-16">
        
        <div class="fixed-square">
            <img src="/assets/img/{{ image }}" alt="{{ artist }} - {{ album }}" class="w-full h-full object-cover border border-white/10 rounded-sm shadow-2xl">
        </div>
        
        <div class="glass-card fixed-square relative overflow-hidden">
            <div>
                <div class="flex justify-between items-start mb-6">
                    <span class="metadata-text text-[#c5a059]">
                        {{ label }} // {{ year }}
                    </span>
                    <div class="text-xl uppercase logo-mojo text-xs">
                        MOJO<span class="logo-lists">LISTS</span>
                    </div>
                </div>
                
                <h1 class="artist-heading text-white mb-2">
                    {{ artist }}
                </h1>
                <h2 class="text-white/70 font-medium tracking-tight text-xl italic font-serif">
                    {{ album }}
                </h2>
            </div>

            <div class="pt-8 flex items-end justify-between bg-transparent border-t border-white/10">
                <div class="flex flex-col">
                    <span class="metadata-text mb-1">Mojo Score</span>
                    <div class="mojo-rating">
                        {{ score }}%
                    </div>
                </div>
                
                <div class="pb-2">
                    <a href="/reviews/" class="btn-gold">
                        ARCHIVE
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-3xl mx-auto review-content space-y-8">
        {{ content | safe }}
    </div>

    {% if youtubeId %}
    <div class="max-w-5xl mx-auto my-16 aspect-video border border-white/10 rounded-sm overflow-hidden shadow-2xl">
        <iframe class="w-full h-full" src="https://www.youtube.com/embed/{{ youtubeId }}" frameborder="0" allowfullscreen></iframe>
    </div>
    {% endif %}
</article>