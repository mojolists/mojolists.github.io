<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Reviews & Articles | MojoLists</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #94a3b8; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        
        .quick-card { 
            background: rgba(30, 41, 59, 0.5); 
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }
        .quick-card:hover {
            background: rgba(30, 41, 59, 0.8);
            border-color: #c5a059;
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="min-h-screen pb-20">
    <nav class="p-8 mb-12 flex justify-between items-center max-w-7xl mx-auto">
        <a href="/" class="logo-font text-3xl text-white font-light tracking-widest uppercase">MojoLists</a>
        <a href="/" class="text-xs uppercase tracking-[0.4em] text-slate-500 hover:text-[#c5a059] transition-colors font-bold">Back Home</a>
    </nav>

    <main class="max-w-5xl mx-auto px-6">
        <header class="mb-16">
            <h1 class="serif text-6xl text-white mb-6">The Archive</h1>
            <div class="max-w-xl relative">
                <input type="text" id="reviewSearch" 
                       placeholder="Search artist or album..." 
                       class="w-full bg-slate-900/50 border border-white/10 rounded-sm py-4 px-6 text-white focus:outline-none focus:border-[#c5a059] transition-colors italic">
            </div>
        </header>

        <div id="cardGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for review in collections.reviews | reverse %}
            {% if not review.data.featured %}
            <a href="{{ review.url }}" 
               class="review-card-item block group" 
               data-title="{{ review.data.album or review.data.title }}" 
               data-artist="{{ review.data.artist }}">
                <div class="quick-card p-4 rounded-sm flex gap-6 items-center">
                    <div class="w-16 h-16 flex-shrink-0 overflow-hidden rounded-sm border border-white/5">
                        <img src="/assets/img/{{ review.data.image or review.data.img }}" 
                             alt="{{ review.data.artist }}" 
                             class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity">
                    </div>
                    <div class="flex-grow min-w-0">
                        <h3 class="text-white font-bold truncate group-hover:text-[#c5a059] transition-colors">{{ review.data.album or review.data.title }}</h3>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-slate-500 font-bold mt-1">{{ review.data.artist }}</p>
                    </div>
                    <div class="text-[#c5a059] font-black italic serif text-xl pr-2">
                        {{ review.data.score or review.data.mojoScore or 0 }}%
                    </div>
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>

        <div id="noResults" class="hidden py-20 text-center">
            <p class="serif text-2xl text-slate-600 italic">No matches found in the archive.</p>
        </div>
    </main>

    <script>
        const searchInput = document.getElementById('reviewSearch');
        const cards = document.querySelectorAll('.review-card-item');
        const grid = document.getElementById('cardGrid');
        const noResults = document.getElementById('noResults');

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            let hasResults = false;

            cards.forEach(card => {
                const title = (card.getAttribute('data-title') || "").toLowerCase();
                const artist = (card.getAttribute('data-artist') || "").toLowerCase();

                if (title.includes(term) || artist.includes(term)) {
                    card.classList.remove('hidden');
                    hasResults = true;
                } else {
                    card.classList.add('hidden');
                }
            });

            if (hasResults) {
                noResults.classList.add('hidden');
                grid.classList.remove('hidden');
            } else {
                noResults.classList.remove('hidden');
                grid.classList.add('hidden');
            }
        });
    </script>
</body>
</html>