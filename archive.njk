---
permalink: /reviews/index.html
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Archive | MojoLists</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; color: #94a3b8; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
        }
        .glass-card:hover {
            border-color: #c5a059;
            background: rgba(255, 255, 255, 0.05);
            transform: scale(1.02);
        }
        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
    </style>
</head>
<body class="min-h-screen pb-20">
    <nav class="p-6 mb-8 flex justify-between items-center max-w-[1600px] mx-auto">
        <a href="/" class="logo-font text-2xl text-white font-light tracking-widest uppercase">MojoLists</a>
        <a href="/" class="text-[10px] uppercase tracking-[0.4em] text-slate-500 hover:text-[#c5a059] transition-colors font-bold">Home</a>
    </nav>

    <main class="max-w-[1600px] mx-auto px-6">
        <header class="mb-12">
            <h1 class="serif text-4xl text-white mb-4">The Archive</h1>
            <div class="max-w-xs relative">
                <input type="text" id="reviewSearch" 
                       placeholder="Filter collection..." 
                       class="w-full bg-slate-900/50 border border-white/10 rounded-sm py-2 px-4 text-xs text-white focus:outline-none focus:border-[#c5a059] transition-colors italic">
            </div>
        </header>

        <div id="cardGrid" class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-7 lg:grid-cols-10 gap-3">
            {% for review in collections.all | reverse %}
                {% if review.data.artist or review.data.album or review.data.title %}
                <a href="{{ review.url }}" 
                   class="review-card-item block group" 
                   data-title="{{ review.data.album or review.data.title }}" 
                   data-artist="{{ review.data.artist }}">
                    <div class="glass-card p-2 rounded-sm h-full flex flex-col">
                        <div class="aspect-square mb-2 overflow-hidden rounded-sm bg-slate-900/50 border border-white/5">
                            {% set imgPath = review.data.image or review.data.img or review.data.coverImage %}
                            <img src="{% if '/assets/img/' in imgPath %}{{ imgPath }}{% else %}/assets/img/{{ imgPath }}{% endif %}" 
                                 alt="{{ review.data.artist }}" 
                                 class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-opacity">
                        </div>
                        <div class="flex-grow">
                            <h3 class="text-white font-bold text-[9px] leading-tight group-hover:text-[#c5a059] transition-colors line-clamp-1">
                                {{ review.data.album or review.data.title }}
                            </h3>
                            <p class="text-[7px] uppercase tracking-wider text-slate-600 font-bold mt-1">
                                {{ review.data.artist }}
                            </p>
                        </div>
                        <div class="mt-2 pt-1 border-t border-white/5 flex justify-between items-center">
                            <span class="text-[#c5a059] font-black italic serif text-sm">
                                {{ review.data.score or review.data.mojoScore or 0 }}%
                            </span>
                        </div>
                    </div>
                </a>
                {% endif %}
            {% endfor %}
        </div>

        <div id="noResults" class="hidden py-20 text-center">
            <p class="serif text-xl text-slate-600 italic">No matches found.</p>
        </div>
    </main>

    <script>
        const searchInput = document.getElementById('reviewSearch');
        const cards = document.querySelectorAll('.review-card-item');
        const grid = document.getElementById('cardGrid');
        const noResults = document.getElementById('noResults');

        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            let hasResults = false;

            cards.forEach(card => {
                const title = (card.getAttribute('data-title') || "").toLowerCase();
                const artist = (card.getAttribute('data-artist') || "").toLowerCase();

                if (title.includes(term) || artist.includes(term)) {
                    card.style.display = 'block';
                    hasResults = true;
                } else {
                    card.style.display = 'none';
                }
            });

            noResults.classList.toggle('hidden', hasResults);
            grid.classList.toggle('hidden', !hasResults);
        });
    </script>
</body>
</html>