---
layout: base.njk
permalink: /reviews/index.html
---

<div class="max-w-7xl mx-auto px-6 py-12">
    <nav class="flex flex-col md:flex-row items-center justify-between gap-8 mb-16 border-b border-white/10 pb-12">
        <a href="/" class="text-white text-2xl font-black italic tracking-tighter uppercase">
            MOJO<span class="text-red-600">LISTS</span>
        </a>
        
        <div class="relative w-full md:w-96">
            <input type="text" id="reviewSearch" placeholder="SEARCH THE ARCHIVE..." 
                class="w-full bg-white/5 border border-white/10 rounded-sm px-6 py-3 text-white text-xs font-black tracking-[0.2em] focus:outline-none focus:border-[#c5a059] transition-colors uppercase">
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </span>
        </div>
    </nav>

    <header class="text-center mb-20">
        <h1 class="text-white text-7xl md:text-8xl font-black uppercase tracking-tighter leading-none mb-4">THE ARCHIVE</h1>
        <p class="text-[#c5a059] uppercase tracking-[0.5em] text-[10px] font-black">Quick Access Library // Total Reviews: {{ collections.all | length }}</p>
    </header>

    <div id="reviewGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {%- for post in collections.all | reverse -%}
        {% if post.data.artist or post.data.title %}
        <a href="{{ post.url }}" class="review-card group relative aspect-square overflow-hidden bg-black border border-white/5 rounded-sm" 
           data-artist="{{ post.data.artist | lower }}" 
           data-album="{{ post.data.album | lower }}" 
           data-title="{{ post.data.title | lower }}">
            
            {% set imgSrc = post.data.image %}
            {% if imgSrc and not imgSrc.startsWith('/') and not imgSrc.startsWith('http') %}
                {% set imgSrc = "/assets/img/" + imgSrc %}
            {% endif %}

            <img src="{{ imgSrc }}" alt="{{ post.data.artist }}" class="w-full h-full object-cover opacity-60 group-hover:opacity-100 transition-all duration-500 group-hover:scale-110">
            
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent p-4 flex flex-col justify-end">
                <span class="text-[#c5a059] text-[8px] font-black uppercase tracking-widest mb-1">{{ post.data.label }}</span>
                <h3 class="text-white text-xs font-black uppercase tracking-tighter leading-none mb-1">{{ post.data.artist }}</h3>
                <p class="text-white/40 text-[9px] uppercase italic truncate">{{ post.data.album }}</p>
                
                <div class="absolute top-2 right-2 flex items-baseline bg-black/80 px-2 py-1 backdrop-blur-sm">
                    <span class="text-white font-black text-xs italic">{{ post.data.score }}</span>
                    <span class="text-[#c5a059] font-bold text-[8px] ml-0.5">%</span>
                </div>
            </div>
        </a>
        {% endif %}
        {%- endfor -%}
    </div>
</div>

<script>
    document.getElementById('reviewSearch').addEventListener('input', function(e) {
        const searchTerm = e.target.value.toLowerCase();
        const cards = document.querySelectorAll('.review-card');
        
        cards.forEach(card => {
            const artist = card.getAttribute('data-artist') || '';
            const album = card.getAttribute('data-album') || '';
            const title = card.getAttribute('data-title') || '';
            
            if (artist.includes(searchTerm) || album.includes(searchTerm) || title.includes(searchTerm)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    });
</script>