---
layout: base.njk
title: "Archive"
permalink: /archive/
---

<div class="max-w-7xl mx-auto px-6 py-20 relative z-10">
    <header class="mb-12">
        <h1 class="text-5xl font-black uppercase tracking-tighter text-white mb-2">Collection <span class="logo-lists">Archive</span></h1>
        <p class="text-white/40 uppercase tracking-[0.3em] text-[10px] font-bold">Sortable by performance, production, and mojo</p>
    </header>

    {# Sorting Headers #}
    <div class="grid grid-cols-12 gap-4 px-8 mb-4 items-center">
        <div class="col-span-1"></div>
        <button onclick="sortTable(2)" class="col-span-3 text-left text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Artist</button>
        <button onclick="sortTable(3)" class="col-span-3 text-left text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Album</button>
        <button onclick="sortTable(4)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Year</button>
        <button onclick="sortTable(5)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Perf</button>
        <button onclick="sortTable(6)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Prod</button>
        <button onclick="sortTable(7)" class="col-span-1 text-center text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Dance</button>
        <button onclick="sortTable(8)" class="col-span-1 text-right text-[10px] uppercase tracking-[0.2em] font-black text-white/40 hover:text-[#DAA520] transition-colors">Mojo</button>
    </div>

    {# The Archive List #}
    <div id="archiveList" class="space-y-2">
        {% for review in collections.reviews %}
        {% set s1 = review.data.score1 | default(0) %}
        {% set s2 = review.data.score2 | default(0) %}
        {% set s3 = review.data.score3 | default(0) %}
        {% set avg = ((s1 + s2 + s3) / 3) | round %}

        <a href="{{ review.url }}" class="archive-row glass-card grid grid-cols-12 gap-4 px-8 py-4 items-center group hover:border-[#DAA520]/30 transition-all duration-300">
            {# Album Art Thumbnail #}
            <div class="col-span-1 aspect-square overflow-hidden rounded-sm border border-white/10">
                <img src="/assets/img/{{ review.data.image }}" alt="{{ review.data.album }}" class="w-full h-full object-cover">
            </div>

            <div class="col-span-3 font-bold text-white group-hover:text-[#DAA520] transition-colors truncate">
                {{ review.data.artist }}
            </div>
            
            <div class="col-span-3 text-white/60 text-sm truncate">
                {{ review.data.album }}
            </div>

            <div class="col-span-1 text-center text-white/40 font-mono text-xs">
                {{ review.data.year }}
            </div>

            <div class="col-span-1 text-center text-[#DAA520]/60 font-bold group-hover:text-[#DAA520]">
                {{ s1 }}
            </div>

            <div class="col-span-1 text-center text-[#DAA520]/60 font-bold group-hover:text-[#DAA520]">
                {{ s2 }}
            </div>

            <div class="col-span-1 text-center text-[#DAA520]/60 font-bold group-hover:text-[#DAA520]">
                {{ s3 }}
            </div>

            <div class="col-span-1 text-right italic font-black text-[#DAA520] text-xl">
                {{ avg }}%
            </div>
        </a>
        {% endfor %}
    </div>
</div>

<script>
function sortTable(columnIndex) {
    const list = document.getElementById('archiveList');
    const rows = Array.from(list.getElementsByClassName('archive-row'));
    
    const sortedRows = rows.sort((a, b) => {
        const aVal = a.children[columnIndex - 1].innerText.trim();
        const bVal = b.children[columnIndex - 1].innerText.trim();
        
        if (!isNaN(aVal) && !isNaN(bVal)) {
            return parseFloat(bVal) - parseFloat(aVal);
        }
        return aVal.localeCompare(bVal);
    });

    list.innerHTML = '';
    sortedRows.forEach(row => list.appendChild(row));
}
</script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 4px;
        display: grid;
        text-decoration: none;
    }
    .archive-row:hover {
        background: rgba(218, 165, 32, 0.05);
        transform: translateX(5px);
    }
</style>