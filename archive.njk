---
layout: base.njk
title: "Archive"
permalink: /archive/
---

<div class="max-w-7xl mx-auto px-6 py-20 relative z-10">
    <header class="mb-16">
        <h1 class="text-6xl font-light uppercase tracking-tighter text-white mb-2 logo-mojo">
            Collection <span class="logo-lists text-[#e63946]">Archive</span>
        </h1>
        <div class="flex items-center gap-4">
            <div class="h-[1px] w-8 bg-[#DAA520]/40"></div>
            <p class="text-white/30 uppercase tracking-[0.4em] text-[9px] font-medium">Sortable by performance, production, and mojo</p>
        </div>
    </header>

    {# Sorting Headers #}
    <div class="grid grid-cols-12 gap-4 px-6 mb-6 items-center border-b border-white/5 pb-4">
        <div class="col-span-1"></div>
        <button onclick="sortTable(2)" class="col-span-3 text-left text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Artist</button>
        <button onclick="sortTable(3)" class="col-span-3 text-left text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Album</button>
        <button onclick="sortTable(4)" class="col-span-1 text-center text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Year</button>
        <button onclick="sortTable(5)" class="col-span-1 text-center text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Perf</button>
        <button onclick="sortTable(6)" class="col-span-1 text-center text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Prod</button>
        <button onclick="sortTable(7)" class="col-span-1 text-center text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Dance</button>
        <button onclick="sortTable(8)" class="col-span-1 text-right text-[9px] uppercase tracking-[0.2em] font-bold text-white/20 hover:text-[#DAA520] transition-colors">Mojo</button>
    </div>

    {# The Archive List #}
    <div id="archiveList" class="space-y-1">
        {% for review in collections.reviews %}
        {% set s1 = review.data.score1 | default(0) %}
        {% set s2 = review.data.score2 | default(0) %}
        {% set s3 = review.data.score3 | default(0) %}
        {% set avg = ((s1 + s2 + s3) / 3) | round %}

        <a href="{{ review.url }}" class="archive-row glass-card grid grid-cols-12 gap-4 px-6 py-3 items-center group hover:border-[#DAA520]/20 transition-all duration-500">
            {# Album Art #}
            <div class="col-span-1 aspect-square overflow-hidden rounded-sm border border-white/5">
                <img src="/assets/img/{{ review.data.image }}" alt="{{ review.data.album }}" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity">
            </div>

            {# Artist #}
            <div class="col-span-3 text-sm font-medium text-white/80 group-hover:text-white transition-colors truncate tracking-tight">
                {{ review.data.artist }}
            </div>
            
            {# Album #}
            <div class="col-span-3 text-white/40 text-xs italic font-light truncate">
                {{ review.data.album }}
            </div>

            {# Year #}
            <div class="col-span-1 text-center text-white/20 font-light text-[10px] tracking-widest">
                {{ review.data.year }}
            </div>

            {# Technical Scores #}
            <div class="col-span-1 text-center text-white/40 text-xs font-medium group-hover:text-[#DAA520]/60">
                {{ s1 }}
            </div>
            <div class="col-span-1 text-center text-white/40 text-xs font-medium group-hover:text-[#DAA520]/60">
                {{ s2 }}
            </div>
            <div class="col-span-1 text-center text-white/40 text-xs font-medium group-hover:text-[#DAA520]/60">
                {{ s3 }}
            </div>

            {# Mojo Rating #}
            <div class="col-span-1 text-right italic font-light text-[#DAA520] text-lg logo-mojo">
                {{ avg }}%
            </div>
        </a>
        {% endfor %}
    </div>
</div>

<script>
function sortTable(columnIndex) {
    const list = document.getElementById('archiveList');
    const rows = Array.from(list.getElementsByClassName('archive-row'));
    
    const sortedRows = rows.sort((a, b) => {
        let aVal = a.children[columnIndex - 1].innerText.trim();
        let bVal = b.children[columnIndex - 1].innerText.trim();
        
        if (aVal.includes('%')) aVal = aVal.replace('%', '');
        if (bVal.includes('%')) bVal = bVal.replace('%', '');

        if (!isNaN(aVal) && !isNaN(bVal)) {
            return parseFloat(bVal) - parseFloat(aVal);
        }
        return aVal.localeCompare(bVal);
    });

    list.innerHTML = '';
    sortedRows.forEach(row => list.appendChild(row));
}
</script>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.01);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.03);
        border-radius: 2px;
        text-decoration: none;
    }
    .archive-row:hover {
        background: rgba(255, 255, 255, 0.03);
        transform: scale(1.005);
    }
</style>