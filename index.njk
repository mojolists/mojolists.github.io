---
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MojoLists | The Favored Home of Crate Diggers, Vinyl Flippers and Music Lovers</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        .motto-font { font-family: 'Cormorant Garamond', serif; font-style: italic; }
        :root { --mojo-gold: #c5a059; --mojo-red: #ef4444; }
        .nav-link { transition: all 0.3s ease; color: #94a3b8; position: relative; }
        .nav-link:hover { color: white; }
        .logo-mojo { font-family: 'Cormorant Garamond', serif; font-weight: 300; color: white; }
        .logo-lists { font-family: 'Cormorant Garamond', serif; font-weight: 400; color: #e63946; }
        .review-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .review-card:hover {
            transform: translateY(-8px);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .stat-value { color: #DAA520; font-family: 'Cormorant Garamond', serif; }
    </style>
</head>
<body class="text-slate-200 selection:bg-red-500 selection:text-white">
    <nav class="fixed top-0 left-0 w-full z-50 px-8 py-10 flex justify-between items-center bg-gradient-to-b from-[#0b1120] to-transparent">
        <div class="logo-mojo text-3xl tracking-tighter uppercase">
            MOJO<span class="logo-lists">LISTS</span>
        </div>
        <div class="flex space-x-12 text-[10px] font-bold uppercase tracking-[0.3em]">
            <a href="/" class="nav-link text-white">Home</a>
            <a href="/archive/" class="nav-link">Archive</a>
            <a href="/about" class="nav-link">About</a>
        </div>
    </nav>

    <main class="relative pt-40 px-8 pb-20 max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
            
            <div class="lg:col-span-8 space-y-32">
                <section>
                    <div class="flex items-center space-x-4 mb-12">
                        <div class="h-[1px] w-12 bg-red-600"></div>
                        <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-red-500">Fresh Rotations</span>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        {% for review in collections.reviews | limit(4) %}
                        <a href="{{ review.url }}" class="group">
                            <article class="review-card rounded-sm overflow-hidden flex flex-col h-full">
                                <div class="aspect-square overflow-hidden relative">
                                    <img src="/assets/img/{{ review.data.image }}" alt="{{ review.data.album }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                    <div class="absolute top-4 right-4 bg-black/80 backdrop-blur-md px-3 py-1 border border-white/10">
                                        <span class="text-[10px] font-bold tracking-widest text-[#DAA520]">{{ review.data.year }}</span>
                                    </div>
                                </div>
                                <div class="p-8 flex flex-col flex-grow">
                                    <h3 class="text-[10px] uppercase tracking-[0.3em] text-slate-500 font-bold mb-2">{{ review.data.artist }}</h3>
                                    <h2 class="serif text-2xl text-white group-hover:text-red-500 transition-colors duration-300 leading-tight">{{ review.data.album }}</h2>
                                    <div class="mt-6 pt-6 border-t border-white/5 flex justify-between items-center">
                                        <span class="text-[9px] uppercase tracking-widest text-slate-500">{{ review.data.label }}</span>
                                        <span class="text-xs font-bold text-[#DAA520] italic">{{ ((review.data.score1 + review.data.score2 + review.data.score3) / 3) | round }}%</span>
                                    </div>
                                </div>
                            </article>
                        </a>
                        {% endfor %}
                    </div>
                </section>
            </div>

            <div class="lg:col-span-4 lg:sticky lg:top-40 space-y-12 max-w-[400px] mx-auto w-full">
                <article class="review-card p-8">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="stat-value text-4xl font-bold">13k+</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Unique Albums</p>
                        </div>
                        <div>
                            <span class="stat-value text-4xl font-bold">100%</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Analog Love</p>
                        </div>
                    </div>
                    <p class="text-xs leading-relaxed mt-6 text-slate-300">A living archive of digital, vinyl, and CD reviews updated weekly.</p>
                    <a href="/archive/" class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white pt-6 border-b border-white/10 w-max">Browse All →</a>
                </article>
            </div>

        </div>
    </main>

    <footer class="py-20 text-center border-t border-slate-900 mt-20">
        <p class="text-[11px] motto-font text-center">
            <span class="text-white/50">© 2026 MOJOLISTS |</span> 
            <span class="text-white/80">The Favored Home of Crate Diggers</span>
        </p>
    </footer>
</body>
</html>