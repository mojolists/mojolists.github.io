<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MojoLists | The Favored Home of Crate Diggers, Vinyl Flippers and Music Lovers</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        .motto-font { font-family: 'Cormorant Garamond', serif; font-style: italic; }
        
        :root {
            --mojo-gold: #c5a059;
            --mojo-red: #ef4444;
        }

        .nav-link { 
            transition: all 0.3s ease; 
            color: #94a3b8; 
            position: relative;
            padding-bottom: 4px;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: 0;
            left: 0;
            background-color: var(--mojo-gold);
            transition: width 0.3s ease;
        }

        .nav-link:hover { 
            color: var(--mojo-gold) !important; 
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .review-card {
            background-color: #161e2e;
            border: 1px solid #1e293b;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .review-card:hover { border-color: rgba(197, 160, 89, 0.4); }
        .review-card:hover .artist-title, 
        .review-card:hover .album-subtitle { color: var(--mojo-gold); }

        .img-container {
            background-color: #0f172a;
            aspect-ratio: 1 / 1;
            overflow: hidden;
            border: 1px solid #1e293b;
        }

        .card-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }
        
        .review-card:hover .card-img { transform: scale(1.05); }

        .row-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3em;
            color: var(--mojo-red);
            margin-bottom: 12px;
            display: block;
        }

        .stat-value { color: var(--mojo-gold); font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="text-slate-400">

    <header class="pt-16 pb-10 text-center bg-[#0b1120]">
        <h1 class="logo-font text-9xl text-white font-light tracking-tight mb-2">
            Mojo<span class="text-[#ef4444]">Lists</span>
        </h1>
        
        <div class="flex items-center justify-center gap-6 mt-4">
            <div class="h-[1px] w-12 bg-white/10"></div>
            <p class="text-2xl motto-font tracking-wide">
                <span class="text-white/90">The Favored Home of Crate Diggers,</span>
                <span class="text-[#ef4444] ml-1">Vinyl Flippers and Music Lovers</span>
            </p>
            <div class="h-[1px] w-12 bg-white/10"></div>
        </div>

        <nav class="flex justify-center gap-16 mt-12 text-[14px] font-medium tracking-[0.15em] uppercase">
            <a href="index.html" class="nav-link">Reviews</a>
            <a href="#" class="nav-link">About</a>
        </nav>
    </header>

    <main class="max-w-[1400px] mx-auto px-8 py-10">
        <div class="border-b border-slate-800/60 mb-10 pb-2">
            <h2 class="text-[10px] font-bold uppercase tracking-[0.5em]">The <span class="text-red-500">Collection</span></h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
            
            {# Automation Loop #}
            {% for review in collections.reviews | limit(6) %}
                {% if loop.index <= 3 %}
                <div>
                    {% if loop.index == 1 %}<span class="row-label">Latest Review</span>{% endif %}
                    {% if loop.index == 2 %}<span class="row-label">Most Popular</span>{% endif %}
                    {% if loop.index == 3 %}<span class="row-label">Explore</span>{% endif %}
                    <article class="review-card p-6">
                        <div class="img-container mb-6"><img src="{{ review.data.coverImage }}" class="card-img"></div>
                        <h3 class="serif text-3xl text-white mb-1 artist-title">{{ review.data.artist }}</h3>
                        <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest mb-4 italic album-subtitle">{{ review.data.title }}</p>
                        <p class="text-sm leading-relaxed mb-10 text-slate-300">
                            {% if review.data.snippet %}{{ review.data.snippet }}{% else %}{{ review.templateContent | striptags | truncate(60) }}{% endif %}
                        </p>
                        <a href="{{ review.url }}" class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white border-b border-white/20 w-max pb-1 hover:border-red-500 transition-colors">Read Review →</a>
                    </article>
                </div>
                {% else %}
                <article class="review-card p-6">
                    <div class="img-container mb-6"><img src="{{ review.data.coverImage }}" class="card-img"></div>
                    <h3 class="serif text-3xl text-white mb-1 artist-title">{{ review.data.artist }}</h3>
                    <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest mb-4 italic album-subtitle">{{ review.data.title }}</p>
                    <p class="text-sm leading-relaxed mb-10 text-slate-300">
                        {% if review.data.snippet %}{{ review.data.snippet }}{% else %}{{ review.templateContent | striptags | truncate(60) }}{% endif %}
                    </p>
                    <a href="{{ review.url }}" class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white border-b border-white/20 w-max pb-1">Read Review →</a>
                </article>
                {% endif %}
            {% endfor %}

            <div>
                <span class="row-label">The Toolkit</span>
                <article class="review-card p-8 bg-slate-900/40">
                    <h3 class="serif text-2xl text-white mb-4">Listening Rig</h3>
                    <div class="space-y-4 text-xs tracking-wide">
                        <div>
                            <p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Turntable</p>
                            <p class="text-white">Technics SL-1200MK7</p>
                        </div>
                        <div>
                            <p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Cartridge</p>
                            <p class="text-white">Ortofon 2M Blue</p>
                        </div>
                        <div>
                            <p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Pre-Amp</p>
                            <p class="text-white">Schiit Mani 2</p>
                        </div>
                    </div>
                    <span class="mt-auto text-[10px] font-bold uppercase tracking-widest pt-6" style="color: var(--mojo-gold);">Hardware Guide →</span>
                </article>
            </div>

            <div>
                <span class="row-label">Label Focus</span>
                <article class="review-card p-8 border-red-900/30">
                    <h3 class="serif text-2xl text-white mb-2">Colemine Records</h3>
                    <p class="text-sm leading-relaxed mb-6 text-slate-300">Tracking the complete catalog of Karma Chief, Remined, and the future of Ohio soul.</p>
                    <div class="bg-black/20 p-4 rounded-sm border border-white/5">
                        <p class="text-[9px] font-bold text-red-500 uppercase tracking-widest mb-2">Current Goal</p>
                        <p class="text-xs italic text-slate-300">Completing the Remined 45s collection.</p>
                    </div>
                    <span class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white pt-6">Label Archive →</span>
                </article>
            </div>

            <div>
                <span class="row-label">The Vault</span>
                <article class="review-card p-8">
                    <h3 class="serif text-2xl text-white mb-6">Library Stats</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="stat-value text-4xl font-bold">13k+</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Unique Albums</p>
                        </div>
                        <div>
                            <span class="stat-value text-4xl font-bold">100%</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Analog Love</p>
                        </div>
                    </div>
                    <p class="text-xs leading-relaxed mt-6 text-slate-300">A living archive of digital, vinyl, and CD reviews updated weekly.</p>
                    <span class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white pt-6">Browse All →</span>
                </article>
            </div>

        </div>
    </main>

    <footer class="py-20 text-center border-t border-slate-900 mt-20">
        <p class="text-[11px] motto-font text-center">
            <span class="text-white/50">© 2026 MOJOLISTS |</span> 
            <span class="text-white/80">The Favored Home of Crate Diggers,</span> 
            <span class="text-[#ef4444]">Vinyl Flippers and Music Lovers</span>
        </p>
    </footer>

</body>
</html>