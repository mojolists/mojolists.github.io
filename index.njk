---
layout: false
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MojoLists | The Favored Home of Crate Diggers, Vinyl Flippers and Music Lovers</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400;1,600&family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0b1120; }
        .serif { font-family: 'Playfair Display', serif; }
        .logo-font { font-family: 'Cormorant Garamond', serif; }
        .motto-font { font-family: 'Cormorant Garamond', serif; font-style: italic; }
        :root { --mojo-gold: #c5a059; --mojo-red: #ef4444; }
        .nav-link { transition: all 0.3s ease; color: #94a3b8; position: relative; padding-bottom: 4px; }
        .nav-link:hover { color: var(--mojo-gold) !important; }
        .review-card { 
            background-color: #161e2e; 
            border: 1px solid #1e293b; 
            transition: all 0.3s ease;
            display: flex; 
            flex-direction: column; 
            height: 100%;
            max-width: 300px; /* Reduced by 25% from 400px baseline */
            margin: 0 auto; 
        }
        .review-card:hover { border-color: rgba(197, 160, 89, 0.4); }
        .img-container { background-color: #0f172a; aspect-ratio: 1 / 1; overflow: hidden; border: 1px solid #1e293b; }
        .card-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
        .review-card:hover .card-img { transform: scale(1.05); }
        .row-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3em; color: var(--mojo-red); margin-bottom: 12px; display: block; }
        .stat-value { color: var(--mojo-gold); font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="text-slate-400">
    <header class="pt-16 pb-10 text-center bg-[#0b1120]">
        <h1 class="logo-font text-9xl text-white font-light tracking-tight mb-2">Mojo<span class="text-[#ef4444]">Lists</span></h1>
        <div class="flex items-center justify-center gap-6 mt-4">
            <div class="h-[1px] w-12 bg-white/10"></div>
            <p class="text-2xl motto-font tracking-wide">
                <span class="text-white/90">The Favored Home of Crate Diggers,</span>
                <span class="text-[#ef4444] ml-1">Vinyl Flippers and Music Lovers</span>
            </p>
            <div class="h-[1px] w-12 bg-white/10"></div>
        </div>
        <nav class="flex justify-center gap-16 mt-12 text-[14px] font-medium tracking-[0.15em] uppercase">
            <a href="/reviews/" class="nav-link">Archive</a>
            <a href="/about" class="nav-link">About</a>
        </nav>
    </header>

    <main class="max-w-[1400px] mx-auto px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
            
            {% for review in collections.reviews | limit(6) %}
            <div>
                <span class="row-label">
                    {% if loop.index == 1 %}Latest Review
                    {% elif loop.index == 2 %}Most Popular
                    {% else %}Explore{% endif %}
                </span>
                <article class="review-card p-6">
                    <div class="img-container mb-6">
                        <img src="/assets/img/{{ review.data.image or review.data.coverImage }}" class="card-img" alt="{{ review.data.artist }} - {{ review.data.album }}">
                    </div>
                    <h3 class="serif text-3xl text-white mb-1">{{ review.data.artist }}</h3>
                    <p class="text-[10px] font-bold text-red-500 uppercase tracking-widest mb-4 italic">{{ review.data.album or review.data.title }}</p>
                    <p class="text-sm leading-relaxed mb-10 text-slate-300">{{ review.templateContent | striptags | truncate(80) }}</p>
                    <a href="{{ review.url }}" class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white border-b border-white/20 w-max pb-1">Read Review →</a>
                </article>
            </div>
            {% endfor %}

            <div>
                <span class="row-label">The Toolkit</span>
                <article class="review-card p-8 bg-slate-900/40">
                    <h3 class="serif text-2xl text-white mb-4">Listening Rig</h3>
                    <div class="space-y-4 text-xs tracking-wide">
                        <div><p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Turntable</p><p class="text-white">Technics SL-1200MK7</p></div>
                        <div><p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Cartridge</p><p class="text-white">Ortofon 2M Blue</p></div>
                        <div><p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Pre-Amp</p><p class="text-white">Schiit Mani 2</p></div>
                        <div><p class="text-slate-500 uppercase font-bold text-[9px] mb-1">Speakers</p><p class="text-white">Klipsch The Fives</p></div>
                    </div>
                </article>
            </div>

            <div>
                <span class="row-label">Library Stats</span>
                <article class="review-card p-8">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <span class="stat-value text-4xl font-bold">13k+</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Unique Albums</p>
                        </div>
                        <div>
                            <span class="stat-value text-4xl font-bold">100%</span>
                            <p class="text-[9px] uppercase tracking-tighter text-slate-500 font-bold">Analog Love</p>
                        </div>
                    </div>
                    <p class="text-xs leading-relaxed mt-6 text-slate-300">A living archive of digital, vinyl, and CD reviews updated weekly.</p>
                    <a href="/reviews/" class="mt-auto text-[10px] font-bold uppercase tracking-widest text-white pt-6">Browse All →</a>
                </article>
            </div>

        </div>
    </main>

    <footer class="py-20 text-center border-t border-slate-900 mt-20">
        <p class="text-[11px] motto-font text-center">
            <span class="text-white/50">© 2026 MOJOLISTS |</span> 
            <span class="text-white/80">The Favored Home of Crate Diggers,</span> 
            <span class="text-[#ef4444]">Vinyl Flippers and Music Lovers</span>
        </p>
    </footer>
</body>
</html>