---
layout: base.njk
title: "Home"
---

<div class="red-line"></div>
<h2 class="section-heading">Featured Review</h2>

{% for post in collections.reviews | reverse %}
  {% if loop.first %}
    <div class="featured-card">
        <a href="{{ post.url }}">
            <img src="/assets/img/{{ post.data.image }}" style="width:100%; max-height:500px; object-fit:cover; border-radius:4px;">
            <h1 style="font-size: 3.5rem; margin: 15px 0;">{{ post.data.artist }}</h1>
            <p style="font-size: 1.8rem; color: #ccc; margin: 0;">{{ post.data.album }}</p>
        </a>
    </div>
  {% endif %}
{% endfor %}

<div class="red-line"></div>
<h2 class="section-heading">Latest Reviews</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px;">
    {% for post in collections.reviews | reverse %}
      {% if loop.index > 1 %}
        <div class="review-card">
            <a href="{{ post.url }}">
                <img src="/assets/img/{{ post.data.image }}" style="width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:4px;">
                <h4 style="margin: 10px 0 5px 0;">{{ post.data.artist }}</h4>
                <p style="margin: 0; color: #bbb;">{{ post.data.album }}</p>
            </a>
        </div>
      {% endif %}
    {% endfor %}
</div>
